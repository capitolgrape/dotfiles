{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "font": {
      "rendering": "native",
      "normal": {
         "family": "Adwaita Sans",
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "matugen"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "rounding": 15,
      "opacity": 1,
      "client_side_decorations": {
         "border_width": 2
      },
      "compact_mode": {
         "enabled": false
      },
      "material": "blur"
   }
}
