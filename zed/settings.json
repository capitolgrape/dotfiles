// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
    "disable_ai": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "ui_font_family": "JetBrainsMono Nerd Font",
    "ui_font_size": 20,
    "ui_font_weight": 500.0,
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 22,
    "buffer_font_features": { "calt": true, "liga": true },
    "theme": {
        "mode": "system",
        "light": "Matugen Light",
        "dark": "Matugen Dark",
    },
    "icon_theme": "Material Icon Theme",
    "tab_size": 4,
    "format_on_save": "on",
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "tabs": { "file_icons": true, "show_diagnostics": "errors" },
    "project_panel": { "entry_spacing": "comfortable" },
    "git": { "inline_blame": { "enabled": false } },
    "auto_install_extensions": {
        "matugen": true,
        "material-icon-theme": true,
        "dockerfile": true,
        "fish": true,
        "html": true,
        "kdl": true,
        "log": true,
        "lua": true,
        "markdown-oxide": true,
        "toml": true,
        "xml": true,
        "env": true,
        "git-firefly": true,
    },
}
