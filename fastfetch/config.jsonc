{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "position": "left",
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "width": 10
    },
    "duration": {
      "abbreviation": true
    }
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator",
      "string": "-"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{pacman}"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "display",
      "key": "display",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
  ],
}
